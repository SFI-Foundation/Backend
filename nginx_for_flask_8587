server {
    listen 80;
    listen [::]:80;
    server_name flask.opencodingsociety.com;

    # Proxy Socket.IO connections to 8500
    location /socket.io/ {
        proxy_pass http://localhost:8500;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Proxy all other traffic to Flask app on 8605
    location / {
        proxy_pass http://localhost:8605;
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # Flask owns origin validation and credentialed CORS. Forward OPTIONS
        # unchanged; do not add duplicate Access-Control-Allow-* headers here.

    }
}
