# Placeholders only. Never commit .env. Blank local secrets are generated per process.
# Production: IS_PRODUCTION=true; supply SECRET_KEY (32+ random characters),
# DEFAULT_PASSWORD and ADMIN_PASSWORD (16+ strong characters) through a secret manager.
# Optional prototype API; forbidden when IS_PRODUCTION=true.
SFI_INTERNAL_RESEARCH=false
# Copy to .env; replace all secret placeholders before initialization.
# Blank uses ../Frontend/_data/sfi_specs.json; relative paths start at Backend.
SFI_SPECS_PATH=
FLASK_PORT=8423
# Set true only for the existing HTTPS production cookie configuration.
IS_PRODUCTION=false
SECRET_KEY=
DEFAULT_PASSWORD=
ADMIN_USER=Local Administrator
ADMIN_UID=admin
ADMIN_PASSWORD=
USER_NAME=Local User
USER_UID=user
USER_PASSWORD=
# Optional chatbot key; blank disables generation.
GEMINI_API_KEY=
# Optional MySQL credentials; leave blank for local SQLite.
DB_ENDPOINT=
DB_USERNAME=
DB_PASSWORD=

# Private sources stay outside the repository. Absolute paths recommended.
SFI_PRIVATE_DATA_DIR=../sfi-private-data
# Optional isolated local database; importer still requires explicit --database.
SFI_DATABASE_URI=
